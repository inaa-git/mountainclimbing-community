# Supabase project settings (Project Settings > API in the Supabase dashboard)

# Public: safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never prefix with NEXT_PUBLIC_ and never import it from
# client-side code — it bypasses Row Level Security. Not read by any code
# yet; reserved for future server-only (admin) usage.
SUPABASE_SERVICE_ROLE_KEY=
